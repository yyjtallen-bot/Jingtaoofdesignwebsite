---
import '@/styles/tokens.css';
import '@/styles/base.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import FontFaces from '@/components/FontFaces.astro';
import Cursor from '@/components/Cursor.astro';
import Lightbox from '@/components/Lightbox.astro';
import MobileCta from '@/components/MobileCta.astro';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';

interface Props {
  title?: string;
  description?: string;
  /** 页面底色：paper（纸底，默认）/ sheet（子页的浅纸） */
  surface?: 'paper' | 'sheet';
  noindex?: boolean;
  /** 分享卡片用的图片（案例封面等） */
  image?: ImageMetadata;
}

const { title, description = site.description, surface = 'paper', noindex = false, image } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// 分享卡片只用位图（SVG 不转换）
const ogImage =
  image && image.format !== 'svg' && Astro.site
    ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.site).href
    : undefined;
---

<!doctype html>
<html lang="zh-CN" data-surface={surface}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="theme-color" content="#ede6d7" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap.xml')} />
    <!-- 有脚本时才启用“滚动揭示”的初始隐藏状态 -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <FontFaces />
    <slot name="head" />
  </head>
  <body>
    <a class="skip t-label" href="#main">跳到主要内容</a>
    <slot />
    <MobileCta />
    <Lightbox />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />
  </body>
</html>

<script>
  import { initRevealOnScroll } from '@/scripts/reveal-on-scroll';
  import { initCopyButtons } from '@/scripts/copy';
  initRevealOnScroll();
  initCopyButtons();
</script>

<style is:global>
  html[data-surface='sheet'],
  html[data-surface='sheet'] body {
    background: var(--sheet);
  }
  /* 首页板块自动编号（书架算第 01 个） */
  body {
    counter-reset: sec;
  }
  /* 键盘用户的“跳到主要内容”，平时藏在屏幕外 */
  .skip {
    position: fixed;
    left: var(--gutter);
    top: 8px;
    z-index: calc(var(--z-cursor) + 1);
    padding: 10px 14px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-sans);
    letter-spacing: 0.16em;
    transform: translateY(-160%);
    transition: transform var(--dur-s) var(--ease-out);
  }
  .skip:focus-visible {
    transform: none;
  }
</style>
