---
// 封面共用的图形定义，全页一份（书架和分类子页都引用这里）：
//   1. 网点图案：每种装帧一份（url(#ht-bone)、url(#cv-f2-kraft) 等），颜色跟着装帧色走
//   2. 12 本书的封面设计：每本一个 <symbol id="cv-分类id">，书上用 <use> 引用（设计在 covers.ts）
// 不能放进书本里——远处的书会被隐藏，图案也会跟着不显示；而且每本书在书架上有 3 份，放在这里只画一次。
import { site } from '@/config/site';
import { categories } from '@/data/categories';
import { coverSvg, hasCover } from './covers';

const bindings = ['bone', 'kraft', 'ink', 'accent'];
// 封面用的网点：f = 前景色，a = 主色，o = 主色块上的字色；数字越大点越粗
const dotSets = [
  ['f1', 'cvf', 2.4, 0.6],
  ['f2', 'cvf', 2.6, 0.75],
  ['f3', 'cvf', 2.7, 0.95],
  ['a1', 'cva', 3, 0.45],
  ['a2', 'cva', 2.8, 0.75],
  ['a3', 'cva', 2.6, 1.05],
  ['o1', 'cvo', 2.4, 0.6],
] as const;
---

<svg class="ht-defs" aria-hidden="true" focusable="false">
  {
    bindings.map((b) => (
      <g data-binding={b}>
        <pattern id={`ht-${b}`} width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <circle cx="1.3" cy="1.3" r="0.82" />
        </pattern>
        {dotSets.map(([k, cls, sp, r]) => (
          <pattern id={`cv-${k}-${b}`} width={sp} height={sp} patternUnits="userSpaceOnUse">
            <circle class={cls} cx={sp / 2} cy={sp / 2} r={r} />
          </pattern>
        ))}
      </g>
    ))
  }
  <defs>
    {
      categories
        .filter((c) => hasCover(c.id))
        .map((c) => <symbol id={`cv-${c.id}`} viewBox="0 0 200 280" set:html={coverSvg(c, site.tagline)} />)
    }
  </defs>
</svg>

<style>
  .ht-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .ht-defs circle {
    fill: var(--b-c2);
  }
  .ht-defs .cvf {
    fill: var(--b-fg);
  }
  .ht-defs .cva {
    fill: var(--b-ac);
  }
  .ht-defs .cvo {
    fill: var(--b-on);
  }
</style>
