---
// 封面共用的图形定义，全页一份（书架和分类子页都引用这里）：
//   1. 12 本书的封面设计：每本一个 <symbol id="cv-分类id">，书上用 <use> 引用（设计在 covers.ts）
//   2. 网点图案 url(#ht-装帧)：只给“没有专属设计”的兜底封面用（motifs.ts）
// 不能放进书本里——远处的书会被隐藏，图案也会跟着不显示；而且每本书在书架上有 3 份，放在这里只画一次。
// 注意：专属封面里的网点都是逐个画的，不用图案填充——Edge 在 3D 书架里会把图案填充整块画丢。
import { site } from '@/config/site';
import { categories } from '@/data/categories';
import { coverSvg, hasCover } from './covers';

const bindings = ['bone', 'kraft', 'ink', 'accent'];
---

<svg class="ht-defs" aria-hidden="true" focusable="false">
  {
    bindings.map((b) => (
      <g data-binding={b}>
        <pattern id={`ht-${b}`} width="2.6" height="2.6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <circle cx="1.3" cy="1.3" r="0.82" />
        </pattern>
      </g>
    ))
  }
  <defs>
    {
      categories
        .filter((c) => hasCover(c.id))
        .map((c) => <symbol id={`cv-${c.id}`} viewBox="0 0 200 280" set:html={coverSvg(c, site.tagline)} />)
    }
  </defs>
</svg>

<style>
  .ht-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .ht-defs circle {
    fill: var(--b-c2);
  }
</style>
