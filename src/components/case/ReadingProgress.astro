---
// 顶部阅读进度条：按正文（[data-progress] 元素）读到哪里来计算
---

<div class="rp" aria-hidden="true"><i class="rp-bar"></i></div>

<script>
  const bar = document.querySelector<HTMLElement>('.rp-bar');
  const target = document.querySelector<HTMLElement>('[data-progress]');
  if (bar && target) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = target.getBoundingClientRect();
      const vh = window.innerHeight;
      // 正文顶部到达屏幕 30% 处开始，正文底部到达屏幕底部时读完
      const total = r.height - vh * 0.7;
      const p = total > 0 ? (vh * 0.3 - r.top) / total : r.top < vh * 0.3 ? 1 : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p)).toFixed(4)})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .rp {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: calc(var(--z-ui) + 1);
    height: 2px;
    pointer-events: none;
  }
  .rp-bar {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>
