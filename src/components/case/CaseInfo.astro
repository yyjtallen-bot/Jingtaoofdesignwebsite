---
// 信息条：客户 / 角色 / 时间 / 类型（取自案例 frontmatter）
import type { Case } from '@/lib/cases';

interface Props {
  entry: Case;
}
const d = Astro.props.entry.data;
const rows = [
  { k: '客户', v: d.client },
  { k: '角色', v: d.role },
  { k: '时间', v: d.period },
  { k: '类型', v: d.type },
];
---

<dl class="ci wrap">
  {
    rows.map((r, i) => (
      <div class="ci-cell">
        <dt class="t-label">{r.k}</dt>
        <dd class="mask">
          <span data-reveal style={`--i:${i}`}>
            {r.v}
          </span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .ci {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: var(--sp-6) 0;
  }
  .ci-cell {
    padding: var(--sp-5) var(--sp-4) var(--sp-5) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule-soft);
  }
  .ci-cell + .ci-cell {
    padding-left: var(--sp-4);
    border-left: 1px solid var(--rule-soft);
  }
  .ci dt {
    margin-bottom: var(--sp-2);
    color: var(--muted);
    font-family: var(--font-sans);
    letter-spacing: 0.2em;
  }
  .ci dd {
    margin: 0;
  }
  @media (max-width: 767px) {
    .ci {
      grid-template-columns: 1fr 1fr;
    }
    /* 第二行第一格：去掉左边线（选择器要比上面的 .ci-cell + .ci-cell 更具体） */
    .ci-cell + .ci-cell:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .ci-cell:nth-child(n + 3) {
      border-top: 0;
    }
  }
</style>
