---
// 统一的图片组件：位图（jpg / png / webp / avif）走 Astro 的压缩和多尺寸输出；
// SVG 原样输出（Astro 7 默认不处理 SVG）。全站放图片都用它，换图格式不用改代码。
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> & {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
};

// 其余属性（class、loading、draggable，以及父组件样式需要的作用域标记）原样传给 <img>
const { src, alt, widths, sizes, loading = 'lazy', ...attrs } = Astro.props;
const isSvg = src.format === 'svg';
---

{
  isSvg ? (
    <img src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" {...attrs} />
  ) : (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} {...attrs} />
  )
}
