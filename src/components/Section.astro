---
// 首页板块的统一外框：左侧竖排标题栏（编号自动生成）+ 右侧内容。
// 各板块只管自己的内容，标题栏的样子改这里一处即可。
interface Props {
  id: string;
  title: string;
  en: string;
  /** 标题下的一句话说明，可选 */
  lead?: string;
}
const { id, title, en, lead } = Astro.props;
---

<section id={id} class="sec" aria-labelledby={`${id}-title`}>
  <i class="sec-rule" data-reveal="line" aria-hidden="true"></i>
  <header class="sec-rail">
    <span class="sec-no t-mono" aria-hidden="true"></span>
    <h2 id={`${id}-title`} class="sec-title mask"><span data-reveal>{title}</span></h2>
    <span class="sec-en t-label">{en}</span>
  </header>
  <div class="sec-body">
    {
      lead && (
        <p class="sec-lead mask">
          <span data-reveal>{lead}</span>
        </p>
      )
    }
    <slot />
  </div>
</section>

<style>
  .sec {
    counter-increment: sec;
    position: relative;
    max-width: var(--max);
    margin-inline: auto;
    padding: var(--section-gap) var(--gutter) 0;
    display: grid;
    grid-template-columns: minmax(84px, 1.4fr) 10.6fr;
    column-gap: var(--sp-6);
    scroll-margin-top: 0;
  }
  .sec-rule {
    position: absolute;
    top: calc(var(--section-gap) - var(--sp-7));
    left: var(--gutter);
    right: var(--gutter);
    height: 1px;
    background: var(--rule);
  }

  /* 左侧竖排标题栏：随内容滚动时停在左边 */
  .sec-rail {
    position: sticky;
    top: var(--sp-7);
    align-self: start;
    display: grid;
    justify-items: start;
    gap: var(--sp-4);
    color: var(--accent);
  }
  .sec-no::before {
    content: counter(sec, decimal-leading-zero);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
  }
  .sec-title {
    writing-mode: vertical-rl;
    font-size: clamp(30px, 2.8vw, 42px);
    line-height: 1;
    letter-spacing: 0.24em;
  }
  .sec-en {
    writing-mode: vertical-rl;
    font-size: 10.5px;
    letter-spacing: 0.24em;
  }

  .sec-body {
    min-width: 0;
  }
  .sec-lead {
    max-width: 30em;
    margin-bottom: var(--sp-8);
    font-size: var(--fs-lead);
    line-height: 1.8;
    color: var(--ink-2);
  }

  @media (max-width: 767px) {
    .sec {
      grid-template-columns: 1fr;
      padding-top: calc(var(--section-gap) * 0.75);
    }
    .sec-rule {
      top: calc(var(--section-gap) * 0.75 - var(--sp-6));
    }
    .sec-rail {
      position: static;
      grid-auto-flow: column;
      justify-content: start;
      align-items: baseline;
      gap: var(--sp-3);
      margin-bottom: var(--sp-6);
    }
    .sec-title,
    .sec-en {
      writing-mode: horizontal-tb;
    }
    .sec-title {
      font-size: 30px;
      letter-spacing: 0.12em;
    }
    .sec-lead {
      margin-bottom: var(--sp-7);
      font-size: 16px;
    }
  }
</style>
