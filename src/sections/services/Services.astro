---
// 「服务」：可展开的服务列表（文字在 data.ts）
import Section from '@/components/Section.astro';
import Icon from '@/components/icons/Icon.astro';
import { withBase } from '@/lib/url';
import { services as d } from './data';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Section id="services" title={d.title} en={d.en} lead={d.lead}>
  <div class="svc-list" data-exclusive={d.exclusive ? '' : undefined}>
    {
      d.items.map((s, i) => (
        <details class="svc">
          <summary class="svc-head">
            <span class="svc-no t-mono">{pad(i + 1)}</span>
            <Icon name={s.icon} size={44} class="svc-ico" />
            <h3 class="svc-name">{s.name}</h3>
            <span class="svc-summary">{s.summary}</span>
            <i class="svc-icon" aria-hidden="true" />
          </summary>
          <div class="svc-body">
            <div class="svc-inner">
              <dl class="svc-grid">
                <div>
                  <dt class="t-label">包含</dt>
                  <dd>
                    <ul>
                      {s.includes.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="t-label">交付</dt>
                  <dd>
                    <ul>
                      {s.deliverables.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="t-label">周期</dt>
                  <dd>{s.period}</dd>
                </div>
                <div>
                  <dt class="t-label">参考价格</dt>
                  <dd>{s.price}</dd>
                </div>
              </dl>
              <a class="box svc-cta" href={withBase('/#contact')}>
                咨询这项服务 <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </details>
      ))
    }
  </div>
  {d.note && <p class="svc-note">{d.note}</p>}
</Section>

<script>
  // 展开 / 收起的高度动画（<details> 本身在无脚本时也能用）
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animate(el: HTMLDetailsElement, open: boolean) {
    const body = el.querySelector<HTMLElement>('.svc-body')!;
    body.getAnimations().forEach((a) => a.cancel());
    if (open) el.open = true;
    const h = body.scrollHeight;
    el.classList.toggle('is-open', open);
    if (reduced()) {
      if (!open) el.open = false;
      return;
    }
    const anim = body.animate(
      [{ height: open ? '0px' : `${h}px` }, { height: open ? `${h}px` : '0px' }],
      { duration: 520, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
    );
    if (!open) anim.finished.then(() => (el.open = false)).catch(() => {});
  }

  document.querySelectorAll<HTMLElement>('.svc-list').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLDetailsElement>('details.svc')];
    for (const el of items) {
      el.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        const opening = !el.classList.contains('is-open');
        if (opening && list.hasAttribute('data-exclusive')) {
          items.filter((x) => x !== el && x.classList.contains('is-open')).forEach((x) => animate(x, false));
        }
        animate(el, opening);
      });
    }
  });
</script>

<style>
  .svc-list {
    border-top: 1px solid var(--rule);
  }
  .svc {
    border-bottom: 1px solid var(--rule-soft);
  }
  .svc-head {
    list-style: none;
    display: grid;
    grid-template-columns: 2.4em 44px minmax(0, 1.1fr) minmax(0, 1.6fr) 20px;
    align-items: center;
    gap: var(--sp-5);
    padding-block: var(--sp-6);
    cursor: pointer;
    color: var(--ink);
  }
  /* 悬停 / 展开：图标的主色块轻微错位，像套色印刷 */
  .svc-head:hover,
  .is-open .svc-head {
    --icon-shift-x: 2.5px;
    --icon-shift-y: -2.5px;
  }
  .svc-head::-webkit-details-marker {
    display: none;
  }
  .svc-no {
    font-size: var(--fs-sm);
    color: var(--accent);
  }
  .svc-name {
    font-size: var(--fs-h3);
    transition: color var(--dur-s) var(--ease-out);
  }
  .svc-summary {
    color: var(--ink-2);
  }
  .svc-head:hover .svc-name,
  .is-open .svc-name {
    color: var(--accent);
  }

  /* 加号：两条线，展开时竖线转平变成减号 */
  .svc-icon {
    position: relative;
    align-self: center;
    width: 16px;
    height: 16px;
    color: var(--accent);
  }
  .svc-icon::before,
  .svc-icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 16px;
    height: 1.2px;
    background: currentColor;
    transition: transform var(--dur-m) var(--ease-out);
  }
  .svc-icon::after {
    transform: rotate(90deg);
  }
  .is-open .svc-icon::after {
    transform: rotate(0deg);
  }

  .svc-body {
    overflow: hidden;
  }
  .svc-inner {
    /* 与服务名称左对齐：编号列 + 图标列 + 两个间距 */
    padding: 0 0 var(--sp-7) calc(2.4em + 44px + var(--sp-5) * 2);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6);
    margin: 0 0 var(--sp-6);
  }
  .svc-grid dt {
    color: var(--muted);
    margin-bottom: var(--sp-3);
  }
  .svc-grid dd {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.9;
  }
  .svc-cta {
    height: 40px;
    padding: 0 16px;
    gap: 10px;
    color: var(--accent);
    border-color: var(--accent);
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
  }
  .svc-note {
    margin-top: var(--sp-5);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  @media (max-width: 767px) {
    /* 手机：图标代替编号放在最左 */
    .svc-head {
      grid-template-columns: 36px minmax(0, 1fr) 16px;
      column-gap: var(--sp-4);
      row-gap: 4px;
      padding-block: var(--sp-5);
    }
    .svc-no {
      display: none;
    }
    .svc-head :global(.svc-ico) {
      grid-row: 1 / 3;
      align-self: start;
      width: 36px;
      height: 36px;
    }
    .svc-summary {
      grid-column: 2 / 3;
      grid-row: 2;
      font-size: var(--fs-sm);
    }
    .svc-icon {
      grid-column: 3;
      grid-row: 1;
    }
    .svc-inner {
      padding-left: calc(36px + var(--sp-4));
    }
    .svc-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
