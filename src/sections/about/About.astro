---
// 「关于我」：照片 + 介绍 + 履历时间轴 + 能力标签（文字在 data.ts）
import Img from '@/components/Img.astro';
import Section from '@/components/Section.astro';
import { getPortrait } from '@/lib/assets';
import { about as d } from './data';

const photo = getPortrait(d.photo);
---

<Section id="about" title={d.title} en={d.en} lead={d.lead || undefined}>
  <div class="ab-top">
    <figure class="ab-photo">
      <div class="ab-frame" data-reveal="clip">
        {
          photo ? (
            <Img src={photo} alt={d.photoCaption} widths={[360, 720]} sizes="(max-width: 767px) 70vw, 28vw" />
          ) : (
            <div class="ab-ph">
              <span class="t-label">[照片]</span>
            </div>
          )
        }
      </div>
      <figcaption class="t-label">{d.photoCaption}</figcaption>
    </figure>
    <div class="ab-intro">
      {d.intro.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="ab-bottom">
    <div class="ab-career">
      <h3 class="ab-sub t-label">{d.careerTitle}</h3>
      <ol class="cv">
        {
          d.career.map((c) => (
            <li class="cv-row">
              <span class="cv-time t-mono">{c.time}</span>
              <div class="cv-main">
                <p class="cv-title">
                  <strong>{c.title}</strong>
                  <span class="cv-org">{c.org}</span>
                </p>
                <p class="cv-note">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ab-skills">
      <h3 class="ab-sub t-label">{d.skillsTitle}</h3>
      {
        d.skills.map((g) => (
          <div class="sk-group">
            <p class="sk-name">{g.group}</p>
            <ul class="sk-tags">
              {g.tags.map((t) => (
                <li class="box sk-tag">{t}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .ab-top {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    gap: var(--sp-8);
    align-items: end;
  }
  .ab-photo {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .ab-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-deep);
  }
  .ab-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ab-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
    outline: 1px solid var(--rule-soft);
    outline-offset: -1px;
  }
  .ab-photo figcaption {
    color: var(--muted);
  }
  .ab-intro {
    display: grid;
    gap: var(--sp-5);
    max-width: 30em;
    font-size: var(--fs-lead);
    line-height: 1.95;
    color: var(--ink-2);
  }

  .ab-bottom {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
    gap: var(--sp-8);
    margin-top: var(--sp-9);
  }
  .ab-sub {
    color: var(--accent);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.2em;
    padding-bottom: var(--sp-3);
    margin-bottom: var(--sp-2);
    border-bottom: 1px solid var(--rule);
  }

  /* 履历：左边时间，右边内容，竖线串起来 */
  .cv-row {
    position: relative;
    display: grid;
    grid-template-columns: 9.5em minmax(0, 1fr);
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--rule-soft);
  }
  .cv-time {
    font-size: var(--fs-sm);
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .cv-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-4);
    align-items: baseline;
  }
  .cv-title strong {
    font-weight: 500;
  }
  .cv-org {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .cv-note {
    margin-top: 4px;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  /* 能力标签：直角线框，不用圆角胶囊 */
  .sk-group {
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--rule-soft);
  }
  .sk-name {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .sk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sk-tag {
    height: 28px;
    padding: 0 10px;
    font-size: var(--fs-sm);
    border-color: var(--rule-soft);
    color: var(--ink);
    transition:
      border-color var(--dur-s) var(--ease-out),
      color var(--dur-s) var(--ease-out);
  }
  .sk-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .ab-top,
    .ab-bottom {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }
    .ab-photo {
      width: min(78%, 320px);
    }
    .ab-intro {
      font-size: 16px;
    }
    .ab-bottom {
      margin-top: var(--sp-8);
    }
    .cv-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
